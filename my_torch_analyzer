#!/usr/bin/env python3
"""Train or evaluate a my_torch chessboard analyzer."""

import argparse
import sys

import numpy as np

from my_torch import NeuralNetwork, LABELS
from my_torch.data import encode_batch, load_chess_dataset
from my_torch.optimizers import Adam, SGD


def build_parser():
    parser = argparse.ArgumentParser(
        prog="my_torch_analyzer",
        description="Train or run a neural network on chess positions in FEN notation.",
    )
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--predict", action="store_true", help="Predict a label for every FEN")
    mode.add_argument("--train", action="store_true", help="Train the loaded neural network")
    parser.add_argument("--save", metavar="SAVEFILE", help="Save the trained network here")
    parser.add_argument("--epochs", type=int, default=30)
    parser.add_argument("--batch-size", type=int, default=64)
    parser.add_argument("--learning-rate", type=float, default=0.001)
    parser.add_argument("--optimizer", choices=["adam", "sgd"], default="adam")
    parser.add_argument("--validation-split", type=float, default=0.15)
    parser.add_argument("--weight-decay", type=float, default=1e-5)
    parser.add_argument("loadfile", help="Neural-network file to load")
    parser.add_argument("chessfile", help="Chessboard file containing FEN positions")
    return parser


def split_dataset(x, y, validation_split, rng):
    if not 0.0 <= validation_split < 1.0:
        raise ValueError("Validation split must be in [0, 1)")
    indices = rng.permutation(len(x))
    split = int(len(x) * (1.0 - validation_split))
    return x[indices[:split]], y[indices[:split]], x[indices[split:]], y[indices[split:]]


def train(network, args):
    x, y = load_chess_dataset(args.chessfile)
    rng = np.random.default_rng(0)
    x_train, y_train, x_valid, y_valid = split_dataset(x, y, args.validation_split, rng)
    if args.optimizer == "adam":
        optimizer = Adam(args.learning_rate, weight_decay=args.weight_decay)
    else:
        optimizer = SGD(args.learning_rate, momentum=0.9, weight_decay=args.weight_decay)

    best_loss = float("inf")
    patience, stale = 5, 0
    for epoch in range(1, args.epochs + 1):
        order = rng.permutation(len(x_train))
        losses = []
        for start in range(0, len(order), args.batch_size):
            batch = order[start:start + args.batch_size]
            losses.append(network.train_batch(x_train[batch], y_train[batch], optimizer))
        valid_loss, valid_accuracy = network.evaluate(x_valid, y_valid)
        print(
            f"epoch={epoch:03d} loss={np.mean(losses):.5f} "
            f"val_loss={valid_loss:.5f} val_accuracy={valid_accuracy:.4f}",
            file=sys.stderr,
        )
        if valid_loss < best_loss - 1e-5:
            best_loss, stale = valid_loss, 0
            network.save(args.save or args.loadfile)
        else:
            stale += 1
            if stale >= patience:
                print("early stopping: validation loss stopped improving", file=sys.stderr)
                break
    if not x_valid.size:
        network.save(args.save or args.loadfile)


def predict(network, chessfile):
    with open(chessfile, "r", encoding="utf-8") as fh:
        fens = [line.strip() for line in fh if line.strip()]
    if not fens:
        return
    for index in network.predict(encode_batch(fens)):
        print(LABELS[index])


def main(argv=None):
    args = build_parser().parse_args(argv)
    try:
        network = NeuralNetwork.load(args.loadfile)
        if args.train:
            train(network, args)
        else:
            predict(network, args.chessfile)
    except (OSError, ValueError, KeyError) as error:
        print(f"my_torch_analyzer: {error}", file=sys.stderr)
        return 84
    return 0


if __name__ == "__main__":
    sys.exit(main())
